{
  "id": "bilibili-qr",
  "version": "0.1.0",
  "platform": "bilibili",
  "allowed_origins": [
    "https://passport.bilibili.com",
    "https://www.bilibili.com"
  ],
  "allowed_redirect_origins": [
    "https://passport.bilibili.com",
    "https://www.bilibili.com"
  ],
  "login_url": "/login",
  "modes": [
    "qr"
  ],
  "authentication_verified": false,
  "selectors": [
    {
      "id": "qr",
      "selector": ".login-scan__qrcode img[alt=\"Scan me!\"]",
      "kind": "qr",
      "frame": "main"
    }
  ],
  "refresh": {
    "trigger": "qr_expired",
    "interval": 30,
    "max_attempts": 3
  },
  "identity_probe_supported": true,
  "interaction_supported": true
}
