[
  {
    "id": "page-basics",
    "version": "1.0.0",
    "matches": ["http://*/*", "https://*/*"],
    "js": ["packs/page-basics/content.js"],
    "run_at": "document_idle",
    "actions": [{ "id": "page.metadata" }]
  },
  {
    "id": "account-login",
    "version": "1.0.0",
    "matches": ["http://127.0.0.1/*", "http://localhost/*"],
    "js": ["packs/account-login/content.js"],
    "run_at": "document_idle",
    "rule": "packs/account-login/rules.json",
    "actions": [
      { "id": "login.observe", "sensitive": false },
      { "id": "login.open", "sensitive": false },
      { "id": "login.refresh", "sensitive": false },
      { "id": "login.switch-mode", "sensitive": false }
    ]
  }
]
