{
  "domain": "ecommerce",
  "capability": "ecommerce-platform",
  "param_schema": [
    {"name": "url", "required": true},
    {"name": "platform", "required": false, "default": "auto", "enum": ["jd", "pinduoduo", "douyin", "kuaishou", "xiaohongshu", "vipshop", "suning", "1688", "dewu", "auto"]},
    {"name": "operation", "required": false, "default": "detail", "enum": ["listing", "detail", "reviews"]},
    {"name": "max_results", "required": false, "default": "20"},
    {"name": "max_pages", "required": false, "default": "5"},
    {"name": "cdp_endpoint", "required": false, "default": ""}
  ],
  "steps": [
    {"op": "navigate", "url_template": "{url}"},
    {"op": "wait", "wait_mode": "stable", "selector": "#J_goodsList .gl-item, .c-goods-item, [class*=\"product-box\"], [class*=\"offerCard\"], [class*=\"goods-item\"], [class*=\"product-card\"], [data-offer-id], [data-sku]"},
    {"op": "scroll", "amount": 8000},
    {"op": "wait", "wait_mode": "stable"},
    {"op": "eval_script", "script": "scripts/extract.py", "args": ["{operation}", "{platform}", "--max-results", "{max_results}"]}
  ],
  "pagination": {
    "mode": "url_page",
    "page_param": "page",
    "page_param_map": {"suning": "cp", "1688": "beginPage"},
    "page_index_offset": {"suning": -1},
    "platforms": ["suning", "1688"],
    "stop_when": "result_count < 1",
    "operations": ["listing"]
  },
  "success": {"min_count": 1}
}
